# Copy to .env.local (gitignored) and fill in as needed.

# Which narrative provider the /api/result route uses.
#   mock       — deterministic, no key, personalized-from-answers (default)
#   anthropic  — real AI narrative (added in the feature/anthropic-provider branch)
AI_PROVIDER=mock

# Server-only secret for AI_PROVIDER=anthropic. Never prefix with NEXT_PUBLIC_ —
# it must stay on the server. Unused while AI_PROVIDER=mock.
# ANTHROPIC_API_KEY=
