# Copy to .env.local (gitignored) and fill in as needed.

# Which narrative provider the /api/result route uses. Local dev/test default to
# mock when this is unset; production requires an explicit value so mock deploys
# are intentional.
#   mock       — deterministic, no key, personalized-from-answers (default)
#   anthropic  — real AI narrative via the Anthropic API (needs ANTHROPIC_API_KEY)
AI_PROVIDER=mock

# Server-only secret for AI_PROVIDER=anthropic. Never prefix with NEXT_PUBLIC_ —
# it must stay on the server. Unused while AI_PROVIDER=mock.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional Claude API model override. Defaults to claude-haiku-4-5 when unset.
# ANTHROPIC_MODEL=claude-haiku-4-5
